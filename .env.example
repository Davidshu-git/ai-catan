# 复制为 .env 后填入真实值。.env 已在 .gitignore，不会被提交。
# docker-compose 通过 env_file: .env 自动注入到 catan-server 容器。

# ---- AI Provider 选择 ----
# 可选值 = rule | mock | <模型注册表里的 key>（模型清单见 server/llm/modelRegistry.ts）
# rule     = 规则 AI（不调外部 API）
# mock     = 弱启发式 mock，用于无 API 端到端调试
# qwen36   = 阿里 Qwen 3.6 Plus（OpenAI-compatible，当前默认 LLM）
# deepseek = DeepSeek V4 Flash（OpenAI-compatible，便宜快速）
# 新增模型：在 modelRegistry.ts 加一条，这里直接填它的 key 即可。
AI_PROVIDER=qwen36

# ---- 玩家席位模式 ----
# all-ai = 4 个独立 AI Agent，前端只做观察和控制（默认）
# human0 = P0 是人类，P1-P3 是 AI（旧模式，后续接身份绑定前的临时开关）
# PLAYER_MODE=all-ai

# 默认手动推进；设为 1 则服务端启动后 AI 自动连续行动
# AI_AUTOPLAY=0

# ---- MiniMax（已退役：订阅失效，已从 modelRegistry.ts 注册表移除）----
# anthropic adapter（llmProvider.ts）仍在。重新启用步骤：
#   1) 取消 server/llm/modelRegistry.ts 里 minimax 那条的注释
#   2) 这里填 MINIMAX_API_KEY，并把 AI_PROVIDER 改回 minimax（或前端切换）
# MINIMAX_API_KEY=
# MINIMAX_API_HOST=api.minimaxi.com   # CN；国际版 api.minimax.io
# LLM_MODEL=MiniMax-M2.7              # 模型 ID（大小写敏感）
# MINIMAX_ENABLE_THINKING=0          # 默认关闭 thinking（开启约 15-25s/步）

# ---- 阿里 Qwen（默认 LLM；AI_PROVIDER=qwen36 或前端切到 Qwen 时必填）----
# 使用 omnibot 同款 coding plan key；不要提交真实值
ALI_CODING_PLAN_KEY=
# ALI_CODING_PLAN_BASE_URL=https://coding.dashscope.aliyuncs.com/v1
# QWEN_MODEL=qwen3.6-plus
# QWEN_ENABLE_THINKING=0  # 默认关闭 thinking 模式（开启会导致超时）

# ---- DeepSeek V4 Flash（AI_PROVIDER=deepseek 或前端切到 DeepSeek 时必填）----
# OpenAI-compatible API；不要提交真实值
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-v4-flash

# ---- AI 社交房间（默认值已够用，按需调）----
# 自由社交聊天（嘴炮/结盟/威胁）总开关：默认开；=0 显式关闭以省 token。
# 运行时也可在前端「社交聊天」按钮 / set_social_chat 实时切换。
# SOCIAL_CHAT=1
# 每个游戏回合全场社交发言上限（硬封顶）
# SOCIAL_LINES_PER_TURN=2
# 单个 AI 两次社交发言之间的最小回合间隔
# SOCIAL_COOLDOWN_TURNS=1
# 整局社交发言总上限（兜底）
# SOCIAL_LINES_PER_GAME=40
# 一个交易 session 内"参与方互相反应"的最大轮数（配合 messagesPerSession 双重封顶）
# ROOM_ROUNDS_MAX=2

# ---- 持久化与 trace（默认关；.data/ 已 gitignore）----
# 断线续盘：保存 game + 关系账本 + agent 记忆 + 事件 buffer 快照
# PERSIST=0
# PERSIST_DIR=./.data
# PERSIST_DEBOUNCE_MS=1500
# AI 决策 trace 追加写 JSONL，文件含完整 prompt/modelContext，勿暴露
# TRACE_FILE=0
# 只读 HTTP 查询：/api/sessions 与 /api/traces/{ai,trade,social}
# TRACE_HTTP=0

# ---- 调优旋钮（一般不动）----
# LLM_TIMEOUT_MS=30000
# LLM_TEMPERATURE=0.4
# LLM_MAX_TOKENS=1024
# AI_TICK_MS=460
