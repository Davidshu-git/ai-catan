# 复制为 .env 后填入真实值。.env 已在 .gitignore，不会被提交。
# docker-compose 通过 env_file: .env 自动注入到 catan-server 容器。

# ---- AI Provider 选择 ----
# rule = 规则 AI（默认；不调外部 API）
# mock = 弱启发式 mock，用于无 API 端到端调试
# minimax = MiniMax Anthropic 兼容端点（兼容旧值 llm）
# qwen36  = 阿里 Qwen 3.6 Plus（OpenAI-compatible）
AI_PROVIDER=minimax

# ---- 玩家席位模式 ----
# all-ai = 4 个独立 AI Agent，前端只做观察和控制（默认）
# human0 = P0 是人类，P1-P3 是 AI（旧模式，后续接身份绑定前的临时开关）
# PLAYER_MODE=all-ai

# 默认手动推进；设为 1 则服务端启动后 AI 自动连续行动
# AI_AUTOPLAY=0

# ---- MiniMax（AI_PROVIDER=llm 时必填）----
# 在 https://platform.minimaxi.com/ 申请；CN 用户用 api.minimaxi.com 端点
MINIMAX_API_KEY=
# 不指定则默认 api.minimaxi.com（CN）；国际版用 api.minimax.io
# MINIMAX_API_HOST=api.minimaxi.com
# 模型 ID（大小写敏感）
# LLM_MODEL=MiniMax-M2.7
# MINIMAX_ENABLE_THINKING=0  # 默认关闭 thinking（开启约 15-25s/步，关闭约 2-5s/步）

# ---- 阿里 Qwen（AI_PROVIDER=qwen36 或前端切换到 Qwen 时必填）----
# 使用 omnibot 同款 coding plan key；不要提交真实值
ALI_CODING_PLAN_KEY=
# ALI_CODING_PLAN_BASE_URL=https://coding.dashscope.aliyuncs.com/v1
# QWEN_MODEL=qwen3.6-plus
# QWEN_ENABLE_THINKING=0  # 默认关闭 thinking 模式（开启会导致超时）

# ---- AI 社交房间（默认值已够用，按需调）----
# 自由社交聊天（嘴炮/结盟/威胁）总开关：默认关，防 token 失控；=1 则默认开。
# 运行时也可在前端「社交聊天」按钮 / set_social_chat 实时切换。
# SOCIAL_CHAT=0
# 每个游戏回合全场社交发言上限（硬封顶）
# SOCIAL_LINES_PER_TURN=2
# 单个 AI 两次社交发言之间的最小回合间隔
# SOCIAL_COOLDOWN_TURNS=1
# 整局社交发言总上限（兜底）
# SOCIAL_LINES_PER_GAME=40
# 一个交易 session 内"参与方互相反应"的最大轮数（配合 messagesPerSession 双重封顶）
# ROOM_ROUNDS_MAX=2

# ---- 持久化与 trace（默认关；.data/ 已 gitignore）----
# 断线续盘：保存 game + 关系账本 + agent 记忆 + 事件 buffer 快照
# PERSIST=0
# PERSIST_DIR=./.data
# PERSIST_DEBOUNCE_MS=1500
# AI 决策 trace 追加写 JSONL，文件含完整 prompt/modelContext，勿暴露
# TRACE_FILE=0
# 只读 HTTP 查询：/api/sessions 与 /api/traces/{ai,trade,social}
# TRACE_HTTP=0

# ---- 调优旋钮（一般不动）----
# LLM_TIMEOUT_MS=30000
# LLM_TEMPERATURE=0.4
# LLM_MAX_TOKENS=1024
# AI_TICK_MS=460
