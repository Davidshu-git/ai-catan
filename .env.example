# 复制为 .env 后填入真实值。.env 已在 .gitignore，不会被提交。
# docker-compose 通过 env_file: .env 自动注入到 catan-server 容器。

# ---- AI Provider 选择 ----
# rule = 规则 AI（默认；不调外部 API）
# mock = 弱启发式 mock，用于无 API 端到端调试
# llm  = 调真实大模型（当前接的是 MiniMax-M2.7）
AI_PROVIDER=llm

# ---- MiniMax（AI_PROVIDER=llm 时必填）----
# 在 https://platform.minimaxi.com/ 申请；CN 用户用 api.minimaxi.com 端点
MINIMAX_API_KEY=
# 不指定则默认 api.minimaxi.com（CN）；国际版用 api.minimax.io
# MINIMAX_API_HOST=api.minimaxi.com
# 模型 ID（大小写敏感）
# LLM_MODEL=MiniMax-M2.7

# ---- 调优旋钮（一般不动）----
# LLM_TIMEOUT_MS=30000
# LLM_TEMPERATURE=0.4
# LLM_MAX_TOKENS=1024
# AI_TICK_MS=460
